config main 'main'
	option enabled '0'
	option dns_mode 'dnsmasq'
	option dns_bind '127.0.0.1'
	option dns_port '5353'
	option upstream_dns '223.5.5.5:53'
	option dns_ttl '60'
	option http_mode 'alias_ip'
	option lan_device 'br-lan'
	option alias_ip ''
	option http_bind '0.0.0.0'
	option http_port '18080'
	option redirect_ip ''
	option socket_path '/var/run/xboxdownload.sock'
	option data_dir '/usr/share/xboxdownload/ip'
	option cache_dir '/var/lib/xboxdownload'
	option apply_hook '/usr/libexec/xboxdownload/apply-ip'
	option log_capacity '200'
	list block_ipv6_mac ''

config group 'xbox_cn1'
	option enabled '1'
	option ip_family 'ipv4'
	option selected_ipv4 ''
	option selected_ipv6 ''
	option filter_keyword ''
	option custom_test_url ''

config group 'xbox_cn2'
	option enabled '1'
	option ip_family 'ipv4'
	option selected_ipv4 ''
	option selected_ipv6 ''
	option filter_keyword ''
	option custom_test_url ''

config group 'xbox_app'
	option enabled '1'
	option ip_family 'ipv4'
	option selected_ipv4 ''
	option selected_ipv6 ''
	option filter_keyword ''
	option custom_test_url ''

config group 'akamai'
	option enabled '0'
	option ip_family 'ipv4'
	option selected_ipv4 ''
	option selected_ipv6 ''
	option filter_keyword ''
	option custom_test_url ''

config speedtest 'speedtest'
	option auto_enabled '1'
	option interval_hours '12'
	option prefer_hour '4'
	option defer_active_minutes '15'
	option switch_threshold_pct '20'
	option min_speed_mbps '5.0'
	option prefilter_concurrency '24'
	option prefilter_top_n '10'
	option download_concurrency '4'
	option download_range_mb '8'
	option download_timeout_secs '6'
	option tcp_timeout_ms '1500'
	option ip_sync_enabled '1'
	option ip_sync_mirror 'github'
	option ip_sync_custom_base ''
